{
  "expo": {
    "name": "PoketTool",
    "slug": "PoketTool",
    "version": "4.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon3.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon3.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.empanada.PoketTool",
      "version": "10",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "\n-keep class com.google.mlkit.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_text_common.** { *; }\n-keep class com.google.android.gms.internal.mlkit_vision_common.** { *; }\n-dontwarn com.google.mlkit.**\n"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Cámara para escanear facturas / Camera to scan receipts",
          "photosPermission": "Fotos para escanear facturas / Photos to scan receipts",
          "microphonePermission": false
        }
      ],
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "vision"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-asset",
      "./plugins/withOptionalScreenPortrait"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6b81ba23-aae7-4420-94b5-0a0d5062165b"
      }
    }
  }
}
